{
  "name": "api",
  "version": "1.0.0",
  "description": "API da Papelaria Express",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "migrate": "node migrate.js",
    "test": "node --test test/unit/*.test.js",
    "test:integration": "DATABASE_URL=postgresql://postgres:postgres@localhost:5433/papelaria node --test test/integration/*.test.js",
    "lint": "eslint .",
    "serve:front": "http-server ../front -p 5500",
    "cy:run": "start-server-and-test 'http-server ../front -p 5500 -c-1' 5500 'cypress run'",
    "cy:open": "cypress open"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "cypress": "^15.21.1",
    "eslint": "^10.14.0",
    "globals": "^15.14.0",
    "http-server": "^14.1.1",
    "start-server-and-test": "^3.0.13",
    "supertest": "^7.1.4"
  }
}
